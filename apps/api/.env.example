# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/open-canvas
PORT=5005

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-32-plus-char-random-string
BETTER_AUTH_URL=http://localhost:5005

# Google OAuth (sign-in with Google is the only auth method for now)
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# App URLs
API_URL=http://localhost:5005
WEB_URL=http://localhost:5173

LOG_LEVEL=info
LOG_FORMAT=pretty

# Cloudflare R2 (asset uploads) — bucket must have public access enabled;
# R2_PUBLIC_URL is that bucket's r2.dev URL or custom domain, no trailing slash
R2_ENDPOINT=https://replace-with-your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
R2_BUCKET_NAME=open-canvas-assets-dev
R2_PUBLIC_URL=https://replace-with-your-bucket-public-url